PORT=4000
# Change this to a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=7200
# URL of the React app (needed for CORS with cookies)
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./data/events.db
NODE_ENV=development
